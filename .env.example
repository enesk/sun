# GUIDE_CONCURRENCY_TOTAL=
# GUIDE_CONCURRENCY_REDIS=

###> Tiefenverteidigung gegen Formular-Missbrauch (#8, config/antispam.php) ###
# Zweite Schicht neben Turnstile: Honeypot, Mindest-Ausfuellzeit, Rate-Limits,
# Wegwerf-E-Mail-Sperrliste. Keine Schluessel, keine fremden Dienste.
# Auskommentiert, weil ein leerer Wert die Vorgabe aus config/antispam.php
# ueberschreiben wuerde ('' statt true).
#
# Notschalter des ganzen Pakets; Vorgabe true.
# ANTISPAM_ENABLED=true
#
# MX-Pruefung der Mail-Domain. Vorgabe false: sie geht ueber DNS, kostet Zeit
# im Request und schlaegt bei einem langsamen Resolver falsch an.
# ANTISPAM_MX_CHECK=false
#
# Bestandsbereinigung (#10): ab wie vielen von 100 Punkten ein Konto oder ein
# Eintrag als sichtungswuerdig gilt. Vorgabe 70; ueberschreibbar je Lauf mit
# `antispam:scan --threshold=`.
# ANTISPAM_BOT_THRESHOLD=70
###< Tiefenverteidigung ###
