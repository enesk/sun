# Beispielkonfiguration. Kopieren nach .env und ausfüllen:
#   cp .env.example .env && php artisan key:generate
#
# Regeln:
#   - Diese Datei enthält NIE echte Zugangsdaten. Sie wird versioniert und von
#     scripts/secret-scan.php mitgeprüft.
#   - Schlüssel gehören ausschließlich in die lokale .env, nie als Vorgabewert
#     in den Code: im Code nur env('NAME') ohne zweiten Parameter lesen.
#   - Nicht aufgeführte Feineinstellungen der Content-Pipeline (Zeitfenster,
#     Grenzwerte, Modellnamen) stehen mit sinnvollen Vorgaben in config/content.php
#     und müssen hier nicht gesetzt werden.

APP_NAME="SaaSykit"
APP_DESCRIPTION=""
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
ASSET_URL=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=

# --- Datenbank (zentral) -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Mandantenfähigkeit ------------------------------------------------------
CENTRAL_DOMAIN=
CENTRAL_DOMAINS=
TENANCY_DB_ISOLATION=false
CREATE_TENANT_ON_USER_REGISTRATION=false
ALLOW_USER_TO_CREATE_TENANTS_FROM_DASHBOARD=true
CAN_ADD_TENANT_SPECIFIC_ROLES_FROM_TENANT_DASHBOARD=true
TENANT_MULTIPLE_SUBSCRIPTIONS_ENABLED=false
TEAMS_ENABLED=true

# --- Cache, Queue, Session, Redis -------------------------------------------
CACHE_DRIVER=file
CACHE_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
FILESYSTEM_DISK=local
FILAMENT_FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

PREMIUM_ENTITLEMENT_CACHE_STORE=

HORIZON_PATH=horizon
HORIZON_DOMAIN=

# --- E-Mail ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
POSTMARK_TOKEN=
RESEND_KEY=

# --- AWS ---------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Zahlungsanbieter --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=

PADDLE_VENDOR_ID=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_VENDOR_AUTH_CODE=
PADDLE_PUBLIC_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_IS_SANDBOX=true

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_IS_TEST_MODE=true

DEFAULT_CURRENCY=EUR
PAYMENT_PRORATION_ENABLED=true

# --- Anmeldung über soziale Netzwerke ---------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_CALLBACK=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_CALLBACK=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK=

# --- Verifizierung, Zwei-Faktor, Captcha ------------------------------------
TWO_FACTOR_AUTH_ENABLED=true
OTP_LOGIN_ENABLED=true
RECAPTCHA_ENABLED=false
VERIFICATION_DEFAULT_PROVIDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Datenimport (Firmendaten) ----------------------------------------------
GOOGLE_PLACES_API_KEY=
# Preis je 1000 Place-Details-Aufrufe in USD (Essentials-Stufe, nur addressComponents).
GOOGLE_PLACES_DETAILS_RATE_USD=5.00
IMPORT_DB_HOST=
IMPORT_DB_PORT=3306
IMPORT_DB_DATABASE=
IMPORT_DB_USERNAME=
IMPORT_DB_PASSWORD=
MAKLER_DB_HOST=
MAKLER_DB_PORT=3306
MAKLER_DB_DATABASE=
MAKLER_DB_USERNAME=
MAKLER_DB_PASSWORD=
SOLAR_DB_HOST=
SOLAR_DB_PORT=3306
SOLAR_DB_DATABASE=
SOLAR_DB_USERNAME=
SOLAR_DB_PASSWORD=
LEGACY_PHOTOS_PATH=

# --- Content-Pipeline: Modellanbieter ---------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
FAL_API_KEY=
UNSPLASH_ACCESS_KEY=
AI_PROVIDER=anthropic

# --- Content-Pipeline: Quellen ----------------------------------------------
# Dienstkonto-Dateien liegen NIE unter public/ und NIE im Repository.
# Konventioneller Ablageort: storage/app/private/google/search-console.json
# Leer lassen, solange keine Datei da ist: content:golive:check wertet einen
# gesetzten Pfad ohne Datei als Fehler, den leeren Wert nur als Warnung.
GOOGLE_SERVICE_ACCOUNT_JSON=
ADSENSE_SERVICE_ACCOUNT_JSON=
ADSENSE_ACCOUNT_ID=
CONTENT_ADSENSE_ENABLED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GENESIS_USERNAME=
GENESIS_PASSWORD=
REGIONALSTATISTIK_USERNAME=
REGIONALSTATISTIK_PASSWORD=

# --- Content-Pipeline: Betrieb ----------------------------------------------
CONTENT_PIPELINE_ENABLED=false
CONTENT_PANEL_PATH=content
CONTENT_ALERT_MAIL=
CONTENT_AUTHOR_USER_ID=
CONTENT_BUDGET_DAILY_USD=
CONTENT_BUDGET_DAILY_USD_PER_TENANT=
CONTENT_BUDGET_MONTHLY_USD=
CONTENT_INDEXNOW_ENABLED=true
CONTENT_SOURCES_RESPECT_ROBOTS=true
# Gap-Connector gsc_gap (Search Console). Ohne diesen Schalter ist der
# Connector nicht registriert und content:sources:run meldet
# "Unbekannter Quell-Connector 'gsc_gap'". Braucht GOOGLE_SERVICE_ACCOUNT_JSON
# und eine gepflegte gsc_property je Portal.
CONTENT_SOURCES_GSC_ENABLED=false

# --- Werkzeuge im Betrieb ----------------------------------------------------
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
GOOGLE_TRACKING_ID=
TRACKING_SCRIPTS=
ROADMAP_ENABLED=true
ADMIN_SETTINGS_ENABLED=true

# Pfad zur Claude-CLI (Firmenbeschreibungen, profiles:rewrite-descriptions)
CLAUDE_CLI_BINARY=
