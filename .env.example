# Beispielkonfiguration. Kopieren nach .env und ausfüllen:
#   cp .env.example .env && php artisan key:generate
#
# Regeln:
#   - Diese Datei enthält NIE echte Zugangsdaten. Sie wird versioniert und von
#     scripts/secret-scan.php mitgeprüft.
#   - Schlüssel gehören ausschließlich in die lokale .env, nie als Vorgabewert
#     in den Code: im Code nur env('NAME') ohne zweiten Parameter lesen.
#   - Nicht aufgeführte Feineinstellungen der Content-Pipeline (Zeitfenster,
#     Grenzwerte, Modellnamen) stehen mit sinnvollen Vorgaben in config/content.php
#     und müssen hier nicht gesetzt werden.

APP_NAME="SaaSykit"
# Plattformname in Mails ohne Portal-Kontext (nie APP_NAME)
APP_PLATFORM_NAME=
APP_DESCRIPTION=""
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
ASSET_URL=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=

# --- Datenbank (zentral) -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Mandantenfähigkeit ------------------------------------------------------
CENTRAL_DOMAIN=
CENTRAL_DOMAINS=
TENANCY_DB_ISOLATION=false
CREATE_TENANT_ON_USER_REGISTRATION=false
ALLOW_USER_TO_CREATE_TENANTS_FROM_DASHBOARD=true
CAN_ADD_TENANT_SPECIFIC_ROLES_FROM_TENANT_DASHBOARD=true
TENANT_MULTIPLE_SUBSCRIPTIONS_ENABLED=false
TEAMS_ENABLED=true

# --- Cache, Queue, Session, Redis -------------------------------------------
CACHE_DRIVER=file
CACHE_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
FILESYSTEM_DISK=local
FILAMENT_FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

PREMIUM_ENTITLEMENT_CACHE_STORE=

HORIZON_PATH=horizon
HORIZON_DOMAIN=

# --- E-Mail ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

