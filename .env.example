# --- Cloudflare Turnstile (config/turnstile.php, docs/turnstile.md) ----------
# Vorgabe sind die Cloudflare-Testschluessel "always pass"; sie gelten auf jeder
# Domain inklusive localhost. Produktionsschluessel stehen im Passwort-Manager
# (Eintrag "SUN / Cloudflare Turnstile"), nie im Repo.
# Weitere Testschluessel (Sitekey / Secret):
#   1x00000000000000000000AA  sichtbar, besteht immer
#   2x00000000000000000000AB  sichtbar, scheitert immer
#   1x00000000000000000000BB  unsichtbar, besteht immer
#   2x00000000000000000000BB  unsichtbar, scheitert immer
#   3x00000000000000000000FF  erzwingt die interaktive Aufgabe
#   1x0000000000000000000000000000000AA  Secret, besteht immer
#   2x0000000000000000000000000000000AA  Secret, scheitert immer
#   3x0000000000000000000000000000000AA  Secret, Token schon verbraucht
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Gruppe B und C (docs/turnstile.md Abschnitt 8) haben eigene Widgets. Welches
# Portal welche Gruppe nutzt, entscheidet der Hostname der Anfrage anhand der
# Listen in config/turnstile.php ('groups'). Lokal nicht gesetzt: dann greift
# Gruppe A mit den Testschluesseln. Auf Produktion traegt
# scripts/turnstile-schluessel-eintragen.sh alle sechs Werte ein; danach prueft
# 'php artisan turnstile:keys:check --siteverify' jede Gruppe.
# TURNSTILE_SITE_KEY_B=
# TURNSTILE_SECRET_KEY_B=
# TURNSTILE_SITE_KEY_C=
# TURNSTILE_SECRET_KEY_C=
# Leer lassen heisst '' und nicht die Vorgabe — deshalb auskommentiert.
# TURNSTILE_ENABLED=true
# Social Login als Registrierungsweg oeffnen (ohne Turnstile, #6)
# TURNSTILE_ALLOW_OAUTH_REGISTRATION=false
# TURNSTILE_FAIL_MODE=open
# TURNSTILE_TIMEOUT_SECONDS=5
# TURNSTILE_VERIFY_HOSTNAME=true
# TURNSTILE_VERIFY_ACTION=true
# TURNSTILE_MODE_REGISTRATION=managed
# TURNSTILE_MODE_COMPANY_LISTING=managed
# TURNSTILE_MODE_LEAD_REQUEST=non_interactive
# TURNSTILE_MODE_CONTACT=non_interactive
# TURNSTILE_SCRIPT_URL=
# TURNSTILE_SITEVERIFY_URL=
# TURNSTILE_LOG_ENABLED=true
# TURNSTILE_LOG_RETENTION_DAYS=90
# Circuit Breaker light (#4): nach 5 Siteverify-Fehlern in 60 s fuer 60 s
# direkt in den Fail-Mode, statt jede Anfrage 5 s warten zu lassen.
# TURNSTILE_BREAKER_ENABLED=true
# TURNSTILE_BREAKER_STORE=file
# TURNSTILE_BREAKER_THRESHOLD=5
# TURNSTILE_BREAKER_WINDOW_SECONDS=60
# TURNSTILE_BREAKER_COOLDOWN_SECONDS=60
# Log-Pruning (#12): Zeilen je Runde beim Loeschen (DELETE mit LIMIT)
# TURNSTILE_PRUNE_CHUNK=1000

# --- Bot-Schutz: Alarme und Tagesbericht (#12) -------------------------------
# turnstile:monitor laeuft stuendlich, turnstile:report taeglich.
# Empfaenger als Komma-Liste. Leer = alle Administratoren mit "update settings".
# TURNSTILE_ALERT_RECIPIENTS=
# TURNSTILE_ALERTS_ENABLED=true
# TURNSTILE_REPORT_MAIL=true
# Cache-Store fuer die Alarm-Entdopplung (leer = Standard-Store)
# TURNSTILE_ALERT_CACHE_STORE=
# Fehlerquote: Anteil und Mindestzahl Pruefungen in der Stunde
# TURNSTILE_ALERT_ERROR_SHARE=0.3
# TURNSTILE_ALERT_ERROR_SHARE_MIN_CHECKS=10
# Absolute Fehlerzahl in einer Stunde
# TURNSTILE_ALERT_ERROR_COUNT=20
# Siteverify-Ausfall (#19, SUN-TS-011): Schwelle, Fenster und Ruhezeit in
# Sekunden. Vorgabe 20 Ausfaelle in 5 Minuten, danach 30 Minuten Ruhe.
# Store wie beim Circuit Breaker: file zaehlt je Portal.
# TURNSTILE_ALERT_OUTAGE_THRESHOLD=20
# TURNSTILE_ALERT_OUTAGE_WINDOW_SECONDS=300
# TURNSTILE_ALERT_OUTAGE_COOLDOWN_SECONDS=1800
# TURNSTILE_ALERT_OUTAGE_STORE=file
# Blockierungsquote der Registrierung: Mindestmenge, Unter- und Obergrenze
# TURNSTILE_ALERT_BLOCK_MIN_REGISTRATIONS=50
# TURNSTILE_ALERT_BLOCK_SHARE_LOW=0.01
# TURNSTILE_ALERT_BLOCK_SHARE_HIGH=0.95

# --- Content-Security-Policy (#11, #21) -------------------------------------
# enforce = blocken (Vorgabe seit #21), report = nur melden
# (Content-Security-Policy-Report-Only), off = kein Header.
# Quellenliste und die Ableitungen (Turnstile, Leadsystem, Vite-Dev-Server):
# config/csp.php. Die Themes liefern keine Inline-Skripte mehr aus, darum
# steht 'unsafe-inline' nicht in script-src und gehoert dort nicht hinein.
# CSP_MODE=enforce
# Zusaetzliche Quellen je Direktive, leerzeichengetrennt — nur fuer Dinge, die
# je Installation abweichen. Der Vite-Dev-Server braucht das NICHT: solange
# `npm run dev` laeuft, haengt die Middleware localhost:5173 (samt ws://)
# selbst an script-src, style-src und connect-src.
# CSP_EXTRA_SCRIPT_SRC=
# CSP_EXTRA_FRAME_SRC=
# CSP_EXTRA_CONNECT_SRC=

